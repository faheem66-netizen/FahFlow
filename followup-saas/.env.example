# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/followup_saas

# Firebase Admin (login/signup verification only)
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# Paste the values from that downloaded JSON below. Keep the \n escapes in the private key.
FIREBASE_PROJECT_ID=fahflow-b0867
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@fahflow-b0867.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Google OAuth for GMAIL ACCESS ONLY (separate from Firebase login).
# This is a normal Google Cloud OAuth client, not part of Firebase Auth,
# because it needs offline access (a refresh token) to read/send Gmail
# in the background — Firebase's client-side Google sign-in does not
# provide that.
# Create credentials at console.cloud.google.com -> APIs & Services -> Credentials
# Enable: Gmail API
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Callback for connecting Gmail (requests Gmail read/send scopes)
GOOGLE_GMAIL_CALLBACK_URL=http://localhost:5000/api/gmail/callback

# Monitoring
FOLLOWUP_CHECK_CRON=*/5 * * * *
